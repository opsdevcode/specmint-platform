{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsdevcode.dev/schemas/opsdevcode.capability-manifest.v1alpha1.json",
  "title": "opsdevcode.capability-manifest/v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "opsdevcode.capability-manifest/v1alpha1"
    },
    "kind": {
      "const": "CapabilityManifest"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "revision": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "mode", "capabilities", "contracts"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "mode": { "const": "fake-local" },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capabilityId",
              "versions",
              "targetKinds",
              "observation",
              "planning",
              "execution",
              "verification",
              "rollback",
              "approvalSchema",
              "evidenceSchema"
            ],
            "properties": {
              "capabilityId": { "type": "string", "minLength": 1 },
              "versions": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "targetKinds": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "observation": { "type": "boolean" },
              "planning": { "type": "boolean" },
              "execution": { "type": "boolean" },
              "verification": { "type": "boolean" },
              "rollback": { "type": "boolean" },
              "approvalSchema": { "type": "string", "minLength": 1 },
              "evidenceSchema": { "type": "string", "minLength": 1 }
            }
          }
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "owner"],
            "properties": {
              "schema": { "type": "string", "minLength": 1 },
              "owner": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
