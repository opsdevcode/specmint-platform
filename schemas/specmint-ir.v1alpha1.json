{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opsdevcode.io/specmint/specmint-ir.v1alpha1.json",
  "title": "SpecMintIR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "irVersion",
    "source",
    "owner",
    "statement",
    "scope",
    "required_capabilities",
    "required_evidence",
    "constraints",
    "exception_rules",
    "convergence",
    "status",
    "declared_targets",
    "identity",
    "provenance"
  ],
  "properties": {
    "apiVersion": { "const": "ir.opsdevcode.io/v1alpha1" },
    "kind": { "const": "SpecMintIR" },
    "irVersion": { "const": "v1alpha1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "id"],
      "properties": {
        "apiVersion": { "type": "string" },
        "kind": { "type": "string" },
        "id": { "type": "string" }
      }
    },
    "owner": { "type": "string" },
    "statement": { "type": "string" },
    "scope": { "type": "object" },
    "required_capabilities": { "type": "array", "items": { "type": "string" } },
    "required_evidence": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "object" },
    "exception_rules": { "type": "object" },
    "convergence": { "type": "object" },
    "status": { "type": "string" },
    "declared_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "version"],
        "properties": {
          "type": { "const": "opsdevcode.compiled-intent" },
          "version": { "type": "string" }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision"],
      "properties": {
        "revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_format", "description"],
      "properties": {
        "source_format": { "enum": ["json", "yaml", "markdown"] },
        "description": { "type": "string" }
      }
    }
  }
}
